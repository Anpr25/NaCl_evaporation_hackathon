# Free-tier keys. Both optional: with neither set, SpecAlive runs on Ollama, and with no
# Ollama either it runs deterministic-only (`--provider none`).

# https://console.groq.com/keys  -- reasoning, adjudication, repair diffs
GROQ_API_KEY=

# https://aistudio.google.com/apikey  -- vision (P&IDs, scanned pages), long context
GEMINI_API_KEY=

# https://openrouter.ai/keys  -- single-key gateway to many hosted models (text + vision);
# used as a fallback tier when Groq/Gemini keys and a local Ollama daemon are all unavailable.
OPENROUTER_API_KEY=

# Only needed if omc is not on PATH and OPENMODELICAHOME is unset.
# SPECALIVE_OMC=C:\Program Files\OpenModelica1.26.3-64bit\bin\omc.exe

# Local models (install: https://ollama.com, then `ollama pull qwen2.5:3b-instruct-q4_K_M`)
OLLAMA_HOST=http://localhost:11434
